SOFTWARE_VERSION_TAG=latest

# Must match the domain Elestio assigned to the service, or generated links and
# secure cookies break.
SERVER_URL=https://REPLACE_WITH_YOUR_ELESTIO_DOMAIN

# openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_SECRET

# Alphanumeric only: interpolated into a Postgres URL that is not URL-encoded.
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=REPLACE_WITH_AN_ALPHANUMERIC_PASSWORD
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default

REDIS_URL=redis://redis:6379

STORAGE_TYPE=local
